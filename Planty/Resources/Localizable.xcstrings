    },
    "Sign out of Planty?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Planty abmelden?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти из Planty?"
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить"
          }
        }
      }
    },
    "Soon you'll add your plants here, and each one becomes a little character that shows how it's doing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bald fügst du hier deine Pflanzen hinzu, und jede wird zu einer kleinen Figur, die zeigt, wie es ihr geht."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скоро здесь появятся ваши растения, и каждое станет маленьким персонажем, который показывает, как у него дела."
          }
        }
      }
    },
    "Take care of your plants, watch them grow and build your own living garden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pflege deine Pflanzen, sieh ihnen beim Wachsen zu und gestalte deinen eigenen lebendigen Garten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ухаживайте за растениями, наблюдайте, как они растут, и создайте свой живой сад."
          }
        }
      }
    },
    "The email or password is not right.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail oder Passwort stimmen nicht."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный email или пароль."
          }
        }
      }
    },
    "The plant encyclopedia is growing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanzen-Enzyklopädie wächst"
          }
        },
