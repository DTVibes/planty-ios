      }
    },
    "Your garden is waiting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten wartet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сад ждёт"
          }
        }
      }
    },
    "Your garden stays on this account only. If you delete the app before adding Apple or email in Profile, your garden is lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten bleibt nur in diesem Konto. Wenn du die App löschst, bevor du im Profil Apple oder E-Mail hinzufügst, geht dein Garten verloren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сад сохранится только в этом аккаунте. Если удалить приложение, не добавив в профиле Apple или email, сад пропадёт."
          }
        }
      }
    },
    "Your plants.\nYour little world.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pflanzen.\nDeine kleine Welt."
