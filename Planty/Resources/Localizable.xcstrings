    "Sign in with Apple did not finish. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Apple wurde nicht abgeschlossen. Bitte versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход через Apple не завершился. Попробуйте ещё раз."
          }
