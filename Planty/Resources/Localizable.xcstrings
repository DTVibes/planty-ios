      }
    },
    "Sign out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти"
          }
        }
